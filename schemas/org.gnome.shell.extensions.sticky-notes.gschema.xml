<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.sticky-notes"
         path="/org/gnome/shell/extensions/sticky-notes/">

    <key name="save-directory" type="s">
      <default>""</default>
      <summary>Notes save directory</summary>
      <description>Custom folder for storing notes JSON (empty = default)</description>
    </key>

    <key name="default-font-size" type="i">
      <default>13</default>
      <summary>Default font size</summary>
    </key>

    <key name="default-title-font-size" type="i">
      <default>14</default>
      <summary>Title font size</summary>
    </key>

    <key name="default-width" type="i">
      <default>300</default>
      <summary>Default note width</summary>
    </key>

    <key name="default-height" type="i">
      <default>260</default>
      <summary>Default note height</summary>
    </key>

    <key name="transparency" type="d">
      <default>0.75</default>
      <summary>Background transparency (0.0–1.0)</summary>
    </key>

    <key name="always-on-top-by-default" type="b">
      <default>true</default>
      <summary>Pin new notes on top by default</summary>
    </key>

    <key name="font-color" type="s">
      <default>"#2C2C2C"</default>
      <summary>Default text color</summary>
    </key>

  </schema>
</schemalist>
